  m_Script: {fileID: 11500000, guid: 018fec536a49c114a9572c0080e9c6b8, type: 3}
  m_Name: WorkFeedback
  m_EditorClassIdentifier: WorkGame::WorkGame.WorkFeedbackSO
  Lines:
  - Id: S1_01
    Result: 0
    Tier: 1
    Text: "\uB098\uB974\uBBF8\uC528 \uB9DE\uC544\uC694. \uC11C\uB958\uC5D0 \uC778\uC0AC\uD55C
      \uBCF4\uB78C\uC774 \uC788\uB124\uC694."
  - Id: S1_02
    Result: 0
    Tier: 1
    Text: "\uC798 \uBD24\uC5B4\uC694. \uC774\uBC88 \uAC74\uC740 \uADF8\uB300\uB85C
      \uC62C\uB9AC\uBA74 \uB418\uACA0\uB124\uC694."
  - Id: S1_03
    Result: 0
    Tier: 1
    Text: "\uB124 \uB9DE\uC2B5\uB2C8\uB2E4. \uB3C4\uC7A5\uC740 \uC81C\uAC00 \uCC0D\uC744
      \uD14C\uB2C8 \uB0B4\uB824\uB193\uC73C\uC138\uC694."
  - Id: S1_04
    Result: 0
    Tier: 1
    Text: "\uC88B\uC544\uC694. \uC2E0\uC785 \uAD50\uC721 \uB54C \uBCF8 \uB0B4\uC6A9
      \uAE30\uC5B5\uD558\uACE0 \uC788\uB124\uC694."
  - Id: S1_05
    Result: 0
    Tier: 1
    Text: "\uC815\uD655\uD574\uC694. \uC11C\uB958\uB3C4 \uB098\uB974\uBBF8\uC528\uB3C4
      \uBB34\uC0AC\uD788 \uD1B5\uACFC\uC785\uB2C8\uB2E4."
  - Id: S1_06
    Result: 0
    Tier: 1
    Text: "\uB9DE\uAC8C \uACE8\uB790\uC5B4\uC694. \uC774\uC81C \uC11C\uB958\uD55C\uD14C
      \uD5C8\uB77D\uC740 \uC548 \uBC1B\uC544\uB3C4 \uB3FC\uC694."
  - Id: S1_07
    Result: 0
    Tier: 1
    Text: "\uB124 \uADF8 \uD310\uB2E8\uC774\uBA74 \uB429\uB2C8\uB2E4. \uB2E4\uC74C
      \uAC83\uB3C4 \uCC28\uBD84\uD788 \uBD10\uC694."
  - Id: S1_08
    Result: 0
    Tier: 1
    Text: "\uC798\uD588\uC5B4\uC694. \uCCAB\uC778\uC0C1\uBCF4\uB2E4 \uBE44\uAD50
      \uD56D\uBAA9\uC744 \uBD10\uC57C \uD558\uAC70\uB4E0\uC694."
  - Id: S1_09
    Result: 0
    Tier: 1
    Text: "\uB9DE\uC544\uC694. \uBBF8\uB798 \uC81C\uD488\uC774\uC5B4\uB3C4 \uD655\uC778\uD560
      \uAC74 \uD655\uC778\uD574\uC57C\uC8E0."
  - Id: S1_10
    Result: 0
    Tier: 1
    Text: "\uC88B\uC2B5\uB2C8\uB2E4. \uBC29\uAE08 \uAC74 \uAC71\uC815 \uB9D0\uACE0
      \uB2E4\uC74C \uC11C\uB958 \uBCF4\uC138\uC694."
  - Id: S2_01
    Result: 0
    Tier: 2
    Text: "\uB098\uB974\uBBF8\uC528 \uC774\uC81C \uC5B4\uB514\uB97C \uBD10\uC57C
      \uD558\uB294\uC9C0 \uC54C\uACA0\uB124\uC694."
  - Id: S2_02
    Result: 0
    Tier: 2
    Text: "\uC774\uBC88\uC5D0\uB3C4 \uC815\uD655\uD574\uC694. \uC5C5\uBB34\uC5D0
      \uC870\uAE08\uC529 \uC775\uC219\uD574\uC9C0\uB124\uC694."
  - Id: S2_03
    Result: 0
    Tier: 2
    Text: "\uC798 \uBD24\uC5B4\uC694. \uC81C\uD488\uC774 \uB9D0\uD558\uB294 \uAC83\uB9CC
      \uBBFF\uC73C\uBA74 \uACE4\uB780\uD558\uC8E0."
  - Id: S2_04
    Result: 0
    Tier: 2
    Text: "\uC88B\uC544\uC694. \uC124\uBA85\uC740 \uC774\uC0C1\uD574\uB3C4 \uD310\uB2E8\uC740
      \uC544\uC8FC \uBA40\uCA61\uD558\uB124\uC694."
  - Id: S2_05
    Result: 0
    Tier: 2
    Text: "\uADF8\uB807\uC8E0. \uB208\uC5D0 \uB744\uB294 \uC22B\uC790\uBCF4\uB2E4
      \uC758\uBBF8\uB97C \uBD10\uC57C\uC8E0."
  - Id: S2_06
    Result: 0
    Tier: 2
    Text: "\uAE54\uB054\uD558\uB124\uC694. \uC81C\uAC00 \uB367\uBD99\uC77C \uB0B4\uC6A9\uC774
      \uC5C6\uC5B4\uC694."
  - Id: S2_07
    Result: 0
    Tier: 2
    Text: "\uC798\uD588\uC5B4\uC694. \uB3C4\uC7A5\uB3C4 \uC694\uC998 \uB098\uB974\uBBF8\uC528\uB97C
      \uB35C \uACBD\uACC4\uD558\uB124\uC694."
  - Id: S2_08
    Result: 0
    Tier: 2
    Text: "\uB9DE\uC544\uC694. \uB0AF\uC120 \uBB3C\uAC74\uC774\uB77C\uACE0 \uAE30\uC900\uAE4C\uC9C0
      \uBC14\uB00C\uC9C4 \uC54A\uC8E0."
  - Id: S2_09
    Result: 0
    Tier: 2
    Text: "\uC88B\uC740 \uD310\uB2E8\uC774\uC5D0\uC694. \uC77D\uACE0 \uACE8\uB790\uB2E4\uB294
      \uAC8C \uBCF4\uC774\uB124\uC694."
  - Id: S2_10
    Result: 0
    Tier: 2
    Text: "\uC815\uD655\uD569\uB2C8\uB2E4. \uC774\uC81C \uC11C\uB958 \uB354\uBBF8\uAC00
      \uB35C \uB0AF\uC124\uACA0\uC5B4\uC694."
  - Id: S3_01
    Result: 0
    Tier: 3
    Text: "\uB098\uB974\uBBF8\uC528 \uC774 \uC815\uB3C4\uBA74 \uD63C\uC790 \uB9E1\uACA8\uB3C4
      \uB418\uACA0\uB124\uC694."
  - Id: S3_02
    Result: 0
    Tier: 3
    Text: "\uC88B\uC740 \uD310\uB2E8\uC774\uC5D0\uC694. \uC124\uBA85\uC774 \uAE38\uC5B4\uB3C4
      \uD575\uC2EC\uC740 \uB193\uCE58\uC9C0 \uC54A\uB124\uC694."
  - Id: S3_03
    Result: 0
    Tier: 3
    Text: "\uC815\uD655\uD574\uC694. \uC81C\uAC00 \uD655\uC778\uD55C \uBD80\uBD84\uC744
      \uB611\uAC19\uC774 \uBD24\uB124\uC694."
  - Id: S3_04
    Result: 0
    Tier: 3
    Text: "\uC694\uC998 \uAC80\uD1A0\uAC00 \uC548\uC815\uC801\uC774\uC5D0\uC694.
      \uACC4\uC18D \uC774\uB807\uAC8C \uD574\uC8FC\uC138\uC694."
  - Id: S3_05
    Result: 0
    Tier: 3
    Text: "\uC798\uD588\uC5B4\uC694. \uB9D0 \uB9CE\uC740 \uC81C\uD488\uB3C4 \uC870\uC6A9\uD788
      \uC2EC\uC0AC\uD558\uB124\uC694."
  - Id: S3_06
    Result: 0
    Tier: 3
    Text: "\uC774\uBC88 \uAC74\uB3C4 \uC190\uBCFC \uB370 \uC5C6\uC5B4\uC694. \uBCF4\uACE0\uC11C\uC5D0
      \uBC14\uB85C \uB123\uACA0\uC5B4\uC694."
  - Id: S3_07
    Result: 0
    Tier: 3
    Text: "\uC88B\uC2B5\uB2C8\uB2E4. \uB098\uB974\uBBF8\uC528 \uC11C\uB958\uB294
      \uC77D\uAE30\uAC00 \uD3B8\uD558\uB124\uC694."
  - Id: S3_08
    Result: 0
    Tier: 3
    Text: "\uC774\uC81C \uBB3C\uAC74\uC774 \uB0A0\uC544\uB2E4\uB140\uB3C4 \uAE30\uC900\uC740
      \uC798 \uC7A1\uB294\uAD70\uC694."
  - Id: S3_09
    Result: 0
    Tier: 3
    Text: "\uC815\uD655\uD55C \uAC80\uD1A0\uC608\uC694. \uB2E4\uC74C \uC5C5\uBB34\uB3C4
      \uBBFF\uACE0 \uB9E1\uAE38\uAC8C\uC694."
  - Id: S3_10
    Result: 0
    Tier: 3
    Text: "\uC88B\uC544\uC694. \uC2E0\uC785\uC774\uB77C\uB294 \uC124\uBA85\uC774
      \uC810\uC810 \uD544\uC694 \uC5C6\uC5B4\uC9C0\uB124\uC694."
  - Id: S4_01
    Result: 0
    Tier: 4
    Text: "\uB098\uB974\uBBF8\uC528 \uD310\uB2E8 \uB355\uBD84\uC5D0 \uAC80\uD1A0\uAC00
      \uD55C\uACB0 \uC218\uC6D4\uD558\uB124\uC694."
  - Id: S4_02
    Result: 0
    Tier: 4
    Text: "\uC774\uBC88\uC5D0\uB3C4 \uC815\uD655\uD569\uB2C8\uB2E4. \uC911\uC694\uD55C
      \uAC74\uC744 \uB9E1\uAE38 \uB9CC\uD558\uB124\uC694."
  - Id: S4_03
    Result: 0
    Tier: 4
    Text: "\uC88B\uC740 \uAC80\uD1A0\uC608\uC694. \uD68C\uC758\uC5D0\uC11C \uC774
      \uD310\uB2E8\uC744 \uADF8\uB300\uB85C \uC124\uBA85\uD558\uC8E0."
  - Id: S4_04
    Result: 0
    Tier: 4
    Text: "\uB098\uB974\uBBF8\uC528\uAC00 \uBA3C\uC800 \uBD10\uC8FC\uB2C8 \uC81C\uAC00
      \uC548\uC2EC\uC774 \uB429\uB2C8\uB2E4."
  - Id: S4_05
    Result: 0
    Tier: 4
    Text: "\uD45C\uD604\uC5D0 \uD718\uB458\uB9AC\uC9C0 \uC54A\uB294\uAD70\uC694.
      \uADF8 \uC810\uC744 \uB192\uC774 \uD3C9\uAC00\uD574\uC694."
  - Id: S4_06
    Result: 0
    Tier: 4
    Text: "\uD6CC\uB96D\uD574\uC694. \uB0A9\uD488 \uB85C\uBD07\uC758 \uC790\uC2E0\uAC10\uBCF4\uB2E4
      \uADFC\uAC70\uB97C \uBBFF\uC5C8\uB124\uC694."
  - Id: S4_07
    Result: 0
    Tier: 4
    Text: "\uC774\uBC88 \uD310\uB2E8\uC740 \uB2E4\uB978 \uC9C1\uC6D0\uB4E4\uC5D0\uAC8C\uB3C4
      \uACF5\uC720\uD558\uACE0 \uC2F6\uB124\uC694."
  - Id: S4_08
    Result: 0
    Tier: 4
    Text: "\uC815\uD655\uD558\uACE0 \uCE68\uCC29\uD574\uC694. \uC9C0\uAE08 \uD398\uC774\uC2A4\uB97C
      \uC720\uC9C0\uD574\uC8FC\uC138\uC694."
  - Id: S4_09
    Result: 0
    Tier: 4
    Text: "\uC81C \uC608\uC0C1\uACFC \uC77C\uCE58\uD569\uB2C8\uB2E4. \uC774\uC81C
      \uB4E0\uB4E0\uD55C \uB3D9\uB8CC\uB124\uC694."
  - Id: S4_10
    Result: 0
    Tier: 4
    Text: "\uC798\uD588\uC5B4\uC694. \uC774 \uC11C\uB958\uB294 \uC81C\uAC00 \uC790\uC2E0
      \uC788\uAC8C \uACB0\uC7AC\uD558\uACA0\uC5B4\uC694."
  - Id: S5_01
    Result: 0
    Tier: 5
    Text: "\uB098\uB974\uBBF8\uC528 \uAC80\uD1A0\uB294 \uC774\uC81C \uBD80\uC11C\uC758
      \uC88B\uC740 \uAE30\uC900\uC774 \uB410\uB124\uC694."
  - Id: S5_02
    Result: 0
    Tier: 5
    Text: "\uD6CC\uB96D\uD569\uB2C8\uB2E4. \uC911\uC694\uD55C \uD310\uB2E8\uC744
      \uBBFF\uACE0 \uB9E1\uAE38 \uC218 \uC788\uACA0\uC5B4\uC694."
  - Id: S5_03
    Result: 0
    Tier: 5
    Text: "\uC774 \uC815\uB3C4 \uC815\uD655\uC131\uC774\uBA74 \uC2E0\uC785 \uD3C9\uAC00\uC11C\uAC00
      \uBAA8\uC790\uB77C\uACA0\uB124\uC694."
  - Id: S5_04
    Result: 0
    Tier: 5
    Text: "\uC774\uBC88 \uAC80\uD1A0\uB294 \uAD50\uC721 \uC790\uB8CC\uB85C \uB0A8\uACA8\uB3C4
      \uC88B\uACA0\uC2B5\uB2C8\uB2E4."
  - Id: S5_05
    Result: 0
    Tier: 5
    Text: "\uC815\uB9D0 \uC798\uD588\uC5B4\uC694. \uC131\uACFC\uB294 \uC81C\uAC00
      \uD3C9\uAC00\uC5D0 \uAF2D \uC801\uC5B4\uB458\uAC8C\uC694."
  - Id: S5_06
    Result: 0
    Tier: 5
    Text: "\uB098\uB974\uBBF8\uC528 \uB355\uBD84\uC5D0 \uAD6D\uBBFC\uAED8 \uB4DC\uB9B4
      \uC124\uBA85\uC774 \uBD84\uBA85\uD574\uC84C\uB124\uC694."
  - Id: S5_07
    Result: 0
    Tier: 5
    Text: "\uC88B\uC740 \uD310\uB2E8\uC785\uB2C8\uB2E4. \uC6B0\uB9AC \uBD80\uC11C\uC5D0
      \uC640\uC918\uC11C \uB2E4\uD589\uC774\uC5D0\uC694."
  - Id: S5_08
    Result: 0
    Tier: 5
    Text: "\uBBF8\uB798 \uBB3C\uAC74\uC740 \uB0AF\uC124\uC5B4\uB3C4 \uB098\uB974\uBBF8\uC528
      \uD310\uB2E8\uC740 \uBBFF\uC74C\uC9C1\uD558\uB124\uC694."
  - Id: S5_09
    Result: 0
    Tier: 5
    Text: "\uD6CC\uB96D\uD574\uC694. \uB2E4\uC74C \uC2E0\uC785\uC5D0\uAC8C\uB3C4
      \uC774 \uAC80\uD1A0\uB97C \uBCF4\uC5EC\uC8FC\uACA0\uC5B4\uC694."
  - Id: S5_10
    Result: 0
    Tier: 5
    Text: "\uC624\uB298\uB3C4 \uC81C \uC2E0\uB8B0\uC5D0 \uB2F5\uD574\uC92C\uB124\uC694.
      \uC815\uB9D0 \uB4E0\uB4E0\uD569\uB2C8\uB2E4."
  - Id: F1_01
    Result: 1
    Tier: 1
    Text: "\uB098\uB974\uBBF8\uC528 \uC774\uBC88 \uAC74\uC740 \uAE30\uC900\uC744
      \uC870\uAE08 \uB2E4\uB974\uAC8C \uBD24\uB124\uC694."
  - Id: F1_02
    Result: 1
    Tier: 1
    Text: "\uAD1C\uCC2E\uC544\uC694. \uB2E4\uC74C\uC5D4 \uBE44\uAD50 \uD56D\uBAA9\uBD80\uD130
      \uD55C \uBC88 \uB354 \uC77D\uC5B4\uBD10\uC694."
  - Id: F1_03
    Result: 1
    Tier: 1
    Text: "\uC774\uBC88 \uC120\uD0DD\uC740 \uC544\uC26C\uC6CC\uC694. \uC22B\uC790\uAC00
      \uB73B\uD558\uB294 \uAC78 \uBA3C\uC800 \uBD10\uC694."
  - Id: F1_04
    Result: 1
    Tier: 1
    Text: "\uC124\uBA85\uC774 \uC880 \uBCC4\uB0AC\uC8E0. \uADF8\uB798\uB3C4 \uAE30\uC900\uC740
      \uB193\uCE58\uBA74 \uC548 \uB3FC\uC694."
  - Id: F1_05
    Result: 1
    Tier: 1
    Text: "\uC11C\uB958\uAC00 \uB0AF\uC124\uC5B4\uB3C4 \uB180\uB77C\uC9C4 \uB9C8\uC138\uC694.
      \uCC9C\uCC9C\uD788 \uC77D\uC73C\uBA74 \uB3FC\uC694."
  - Id: F1_06
    Result: 1
    Tier: 1
    Text: "\uC774\uBC88 \uAC74\uC740 \uB9DE\uC9C0 \uC54A\uB124\uC694. \uB2E4\uC74C
      \uC11C\uB958\uC5D0\uC11C \uB9CC\uD68C\uD574\uBD10\uC694."
  - Id: F1_07
    Result: 1
    Tier: 1
    Text: "\uAE09\uD558\uAC8C \uACE8\uB790\uB098\uC694? \uB2E4\uC74C\uC5D4 \uC7A0\uAE50\uB9CC
      \uB354 \uD655\uC778\uD574\uBD10\uC694."
  - Id: F1_08
    Result: 1
    Tier: 1
    Text: "\uCC98\uC74C\uC5D4 \uD5F7\uAC08\uB9B4 \uC218 \uC788\uC5B4\uC694. \uBB34\uC5C7\uC744
      \uACE0\uB974\uB294\uC9C0 \uBA3C\uC800 \uBD10\uC694."
  - Id: F1_09
    Result: 1
    Tier: 1
    Text: "\uB098\uB974\uBBF8\uC528 \uC11C\uB958\uD55C\uD14C \uC0AC\uACFC\uAE4C\uC9C4
      \uC548 \uD574\uB3C4 \uB429\uB2C8\uB2E4."
  - Id: F1_10
    Result: 1
    Tier: 1
    Text: "\uC774\uBC88 \uD310\uB2E8\uC740 \uBE57\uB098\uAC14\uC5B4\uC694. \uB2E4\uC74C
      \uAC74\uC740 \uCC28\uBD84\uD788 \uAC00\uBD05\uC2DC\uB2E4."
  - Id: F2_01
    Result: 1
    Tier: 2
    Text: "\uB098\uB974\uBBF8\uC528 \uBE44\uC2B7\uD55C \uC2E4\uC218\uAC00 \uC774\uC5B4\uC838\uC694.
      \uAE30\uC900\uBD80\uD130 \uD655\uC778\uD558\uC138\uC694."
  - Id: F2_02
    Result: 1
    Tier: 2
    Text: "\uCC98\uB9AC \uC18D\uB3C4\uBCF4\uB2E4 \uC815\uD655\uB3C4\uAC00 \uBA3C\uC800\uC608\uC694.
      \uC11C\uB450\uB974\uC9C0 \uB9C8\uC138\uC694."
  - Id: F2_03
    Result: 1
    Tier: 2
    Text: "\uC774\uBC88\uC5D0\uB3C4 \uD310\uB2E8\uC774 \uB9DE\uC9C0 \uC54A\uB124\uC694.
      \uC77D\uB294 \uC21C\uC11C\uB97C \uBC14\uAFD4\uBD10\uC694."
  - Id: F2_04
    Result: 1
    Tier: 2
    Text: "\uC81C\uD488 \uC774\uB984 \uB9D0\uACE0 \uBE44\uAD50 \uD56D\uBAA9\uC5D0
      \uC9D1\uC911\uD574\uC8FC\uC138\uC694."
  - Id: F2_05
    Result: 1
    Tier: 2
    Text: "\uD06C\uAE30\uB9CC \uBCF4\uACE0 \uACE0\uB974\uBA74 \uACE4\uB780\uD574\uC694.
      \uC218\uCE58\uC758 \uC758\uBBF8\uB97C \uBCF4\uC138\uC694."
  - Id: F2_06
    Result: 1
    Tier: 2
    Text: "\uB2E4\uC74C \uC11C\uB958\uB294 \uACE0\uB974\uAE30 \uC804\uC5D0 \uAE30\uC900\uC744
      \uD55C \uBC88 \uC9DA\uC5B4\uBCF4\uC138\uC694."
  - Id: F2_07
    Result: 1
    Tier: 2
    Text: "\uB098\uB974\uBBF8\uC528 \uAC10\uC73C\uB85C \uCC98\uB9AC\uD560 \uC5C5\uBB34\uB294
      \uC544\uB2D9\uB2C8\uB2E4."
  - Id: F2_08
    Result: 1
    Tier: 2
    Text: "\uC124\uBA85\uC774 \uC774\uC0C1\uD55C \uAC83\uACFC \uD310\uB2E8\uC744
      \uD2C0\uB9AC\uB294 \uAC74 \uBCC4\uAC1C\uC608\uC694."
  - Id: F2_09
    Result: 1
    Tier: 2
    Text: "\uC2E4\uC218\uAC00 \uC313\uC774\uACE0 \uC788\uC5B4\uC694. \uC9C0\uAE08\uBD80\uD130
      \uC815\uD655\uB3C4\uB97C \uCC59\uACA8\uC8FC\uC138\uC694."
  - Id: F2_10
    Result: 1
    Tier: 2
    Text: "\uD1F4\uADFC\uC774 \uAE30\uB2E4\uB824\uC838\uB3C4 \uAC80\uD1A0\uB294 \uB05D\uAE4C\uC9C0
      \uAF3C\uAF3C\uD558\uAC8C \uD574\uC8FC\uC138\uC694."
  - Id: F3_01
    Result: 1
    Tier: 3
    Text: "\uB098\uB974\uBBF8\uC528 \uAC19\uC740 \uC218\uC900\uC758 \uC2E4\uC218\uAC00
      \uACC4\uC18D\uB3FC\uC120 \uC548 \uB429\uB2C8\uB2E4."
  - Id: F3_02
    Result: 1
    Tier: 3
    Text: "\uC9C0\uAE08\uC740 \uCC98\uB9AC\uB7C9\uBCF4\uB2E4 \uD310\uB2E8\uC758 \uC815\uD655\uC131\uC744
      \uBC14\uB85C\uC7A1\uC544\uC57C \uD574\uC694."
  - Id: F3_03
    Result: 1
    Tier: 3
    Text: "\uC11C\uB958\uB9C8\uB2E4 \uBE44\uAD50 \uAE30\uC900\uC744 \uD655\uC778\uD558\uC138\uC694.
      \uCD94\uCE21\uC73C\uB85C \uACE0\uB974\uC9C0 \uB9C8\uC138\uC694."
  - Id: F3_04
    Result: 1
    Tier: 3
    Text: "\uC774 \uD310\uB2E8\uC740 \uD3C9\uAC00\uC5D0 \uBC18\uC601\uB429\uB2C8\uB2E4.
      \uB2E4\uC74C \uAC74\uC740 \uC2E0\uC911\uD788 \uBCF4\uC138\uC694."
  - Id: F3_05
    Result: 1
    Tier: 3
    Text: "\uBC18\uBCF5\uB41C \uC2E4\uC218\uB85C \uAC80\uD1A0\uB97C \uC2E0\uB8B0\uD558\uAE30
      \uC5B4\uB824\uC6CC\uC9C0\uACE0 \uC788\uC5B4\uC694."
  - Id: F3_06
    Result: 1
    Tier: 3
    Text: "\uB098\uB974\uBBF8\uC528 \uC18D\uB3C4\uB97C \uB0AE\uCD94\uC138\uC694.
      \uD655\uC778\uC744 \uC0DD\uB7B5\uD558\uBA74 \uC548 \uB429\uB2C8\uB2E4."
  - Id: F3_07
    Result: 1
    Tier: 3
    Text: "\uC774 \uC5C5\uBB34\uB294 \uC2E4\uC81C \uB0A9\uD488\uACFC \uC5F0\uACB0\uB3FC\uC694.
      \uCC45\uC784 \uC788\uAC8C \uD310\uB2E8\uD558\uC138\uC694."
  - Id: F3_08
    Result: 1
    Tier: 3
    Text: "\uC81C\uD488 \uC124\uBA85\uC774 \uC544\uBB34\uB9AC \uBCC4\uB098\uB3C4
      \uAE30\uBCF8 \uAE30\uC900\uC740 \uC9C0\uCF1C\uC57C \uD569\uB2C8\uB2E4."
  - Id: F3_09
    Result: 1
    Tier: 3
    Text: "\uC9C0\uAE08 \uAC19\uC740 \uC2E4\uC218\uAC00 \uC774\uC5B4\uC9C0\uBA74
      \uAD50\uC721 \uB0B4\uC6A9\uC744 \uB2E4\uC2DC \uC9DA\uC5B4\uC57C \uD574\uC694."
  - Id: F3_10
    Result: 1
    Tier: 3
    Text: "\uB2E4\uC74C \uC11C\uB958\uBD80\uD130\uB294 \uBB34\uC5C7\uC744 \uACE0\uB974\uB294\uC9C0
      \uBA3C\uC800 \uD655\uC778\uD574\uC8FC\uC138\uC694."
